# Only the static application enters the Vercel upload/build input.
*
!app
!app/**
!vercel.json
!tools
!tools/build_site.mjs
# Application development/source-only metadata is not served.
app/tests
app/README.md
app/package.json

# Dream public runtime: authored development tools/tests remain source-only.
app/dream/tests
app/dream/kit/render.py
app/dream/DEPENDENCIES.json
