{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "const": "sky-whale"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "dataKind": {
      "enum": [
        "prepared-synthetic-demo",
        "local-session-story"
      ]
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sky": {
          "enum": [
            "sunset",
            "night"
          ]
        },
        "cityScale": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.3
        },
        "gardens": {
          "type": "boolean"
        },
        "starBridge": {
          "type": "boolean"
        },
        "whaleColor": {
          "enum": [
            "indigo",
            "teal"
          ]
        }
      },
      "required": [
        "sky",
        "cityScale",
        "gardens",
        "starBridge",
        "whaleColor"
      ]
    },
    "invariants": {
      "const": [
        "flying-whale",
        "city-on-back"
      ]
    },
    "choices": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "vi": {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              "en": {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              }
            },
            "required": [
              "vi",
              "en"
            ]
          },
          "origin": {
            "enum": [
              "child",
              "mentor",
              "ai-proposal",
              "session-input",
              "offline-suggestion",
              "imported-proposal"
            ]
          },
          "status": {
            "enum": [
              "prepared-example",
              "confirmed-in-session"
            ]
          }
        },
        "required": [
          "id",
          "description",
          "origin",
          "status"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "seed",
    "dataKind",
    "world",
    "invariants",
    "choices"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dream-p03:world-spec:2",
  "title": "P03 WorldSpec v2 planner provenance extension",
  "description": "P03-only schema. Runtime enforces unique IDs/nonblank descriptions and five render fields; provenance labels do not authenticate a child or live result."
}
